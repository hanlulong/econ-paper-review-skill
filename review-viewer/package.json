{
  "name": "econ-review-desk",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "sync-review": "node --experimental-strip-types scripts/sync-review.mjs",
    "clear-review-bundles": "node scripts/clear-review-bundles.mjs",
    "dev": "npm run clear-review-bundles && vinext dev",
    "dev:bundled": "npm run sync-review -- --allow-publish && vinext dev",
    "build": "npm run sync-review && vinext build",
    "build:bundled": "npm run sync-review -- --allow-publish && vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "build:release": "npm run build:static && node scripts/build-release.mjs",
    "check:release": "npm run build:static && node scripts/build-release.mjs --check",
    "start": "vinext start",
    "test": "node scripts/test-viewer.mjs && npm run check:release",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern static-dist"
  },
  "dependencies": {
    "katex": "0.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "katex": "$katex"
  },
  "type": "module"
}
